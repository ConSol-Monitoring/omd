#!/bin/bash

### OMD INIT INFO
# PIDFILE:  tmp/run/apache.pid
# DEPENDS:  CONFIG_APACHE_MODE != none
# BINARY:   ###APACHE_BIN###
# ARGMATCH: etc/apache/apache.conf
### END INIT INFO

cd || exit 1
. etc/omd/site.conf
if [ "$CONFIG_APACHE_MODE" == none ]; then
  exit 5
fi
. .profile
. lib/omd/init_profile


[ -r etc/victoriametrics/apache.sh ] && source etc/victoriametrics/apache.sh

# Start httpd in the C locale by default.
HTTPD_LANG="C"

# This will prevent initlog from swallowing up a pass-phrase prompt if
# mod_ssl needs a pass-phrase from the user.
INITLOG_ARGS=""

NAME="apache"
DAEMON="###APACHE_BIN###"
PID_FILE=$OMD_ROOT/tmp/run/apache.pid
OPTS="-f $OMD_ROOT/etc/apache/apache.conf"
STOP_TIMEOUT=15
STOP_CALLBACK="kill_stale_php_cgis"
CHECK_CALLBACK=verify_config
HAS_UNSAFE_ALLOW=""

if "$DAEMON" -t -f "$OMD_ROOT/share/omd/apache-test-unsafeallow.conf" >/dev/null 2>&1 ; then
    HAS_UNSAFE_ALLOW=1
fi

has_unsafe_allow() {
    [ -n "$HAS_UNSAFE_ALLOW" ]
}

mkdir -p $OMD_ROOT/var/log/apache


case "$1" in start|restart|reload)
  # (nearly) reproducible problems with apache at boot-time. (alloc_listener: failed to set up sockaddr for 127.0.0.1)
  # With this ping the problem disappears.
  test -f /etc/debian_version && test $(cut -f1 -d" " /proc/uptime | cut -f1 -d".") -lt 300 && ping -nqc 10 $CONFIG_APACHE_TCP_ADDR >/dev/null 2>&1
esac
case "$1" in stop)
  rsync -a --chmod='F0644' "${OMD_ROOT}/var/www/maint.html" "/omd/apache/maint_${OMD_SITE}.html" >/dev/null 2>&1
esac

# The system Apache reads a root-owned copy of this site's configuration
# below /omd/apache/$OMD_SITE.d.  Refresh that copy through the sudo rule
# the package installs, so a change below etc/apache is live at once
# instead of waiting for the next log rotation.  Without sudo (or without
# the rule) it needs a root step, and the message says which one.
refresh_system_apache() {
  if [ "$(id -u)" = "0" ]; then
    return 0
  fi
  local omd_bin=/usr/bin/omd
  if [ ! -x "$omd_bin" ]; then
    omd_bin="$OMD_ROOT/bin/omd"
  fi
  if command -v sudo >/dev/null 2>&1 && sudo -n "$omd_bin" update-apache-config "$OMD_SITE" >/dev/null 2>&1; then
    return 0
  fi
  echo "Note: run 'omd update-apache-config $OMD_SITE' as root to activate changes below etc/apache in the system Apache." >&2
  return 0
}

# Only when the copy is missing or older than the site's configuration; a
# start of many sites then does not reload the system Apache for each one.
system_apache_copy_is_stale() {
  local staged=/omd/apache/$OMD_SITE.d
  if [ ! -e "$staged/mode.conf" ]; then
    return 0
  fi
  test -n "$(find "$OMD_ROOT/etc/apache" -newer "$staged/mode.conf" -print -quit 2>/dev/null)"
}

case "$1" in
  reload|force-reload)
    refresh_system_apache
  ;;
  start)
    if system_apache_copy_is_stale; then
      refresh_system_apache
    fi
  ;;
esac

kill_stale_php_cgis() {
  local COUNTER=$1
  if [ $COUNTER -ne 50 ]; then
    return
  fi
  i=1
  pkill -u $OMD_SITE -f ###PHP_FCGI_BIN### >/dev/null 2>&1
  while pkill -u $OMD_SITE -f ###PHP_FCGI_BIN### >/dev/null 2>&1
  do
    i=$((i+1))
    if [ $i -gt 50 ] ; then
        return
    fi
    sleep 0.1
  done
}

# override generic reload function
__generic_init_reload() {
  PID=$(__generic_init_pid)
  echo -n " (PID: ${PID})... "
  if ! $DAEMON $OPTS -k graceful; then
    echo "ERROR: failed to send SIGHUP"
    return 1
  fi
  echo "OK"
  return 0
}

verify_config() {
    if [ "$1" != "quiet" ]; then
        echo -n "Running ${NAME} configuration check... "
    fi
    RESULT=$($DAEMON $OPTS -S 2>&1)
    if [ $? -eq 0 ]; then
        if [ "$1" != "quiet" ]; then
            echo "done."
            echo "$RESULT" >&2
        fi
        return 0
    else
        if [ "$1" != "quiet" ]; then
            echo "CONFIG ERROR! Aborted. Check your ${NAME} configuration."
        fi
        echo "$RESULT" >&2
        return 1
    fi
}

copy_and_fix_config() {
    mkdir -p "$OMD_ROOT/tmp/apache/conf.d"
    T="$OMD_ROOT/tmp/apache/conf.d/."
    rsync -acL --delete-after "$OMD_ROOT/etc/apache/conf.d/." "$T"
    if has_unsafe_allow ; then
        find "$T" -type f -print0 | xargs -0 sed -i -e 's/,@@@UNSAFEALLOW3F@@@/,UnsafeAllow3F/g'
    else
        find "$T" -type f -print0 | xargs -0 sed -i -e 's/,@@@UNSAFEALLOW3F@@@//g'
    fi
}

case "$1" in start|restart|reload|checkconfig|check)
    copy_and_fix_config
esac

__generic_init "$*"
