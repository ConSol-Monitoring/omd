#!/bin/bash

### OMD INIT INFO
# PIDFILE:  tmp/run/grafana.pid
# DEPENDS:  CONFIG_GRAFANA = on
# BINARY:   bin/grafana
# ARGMATCH: etc/grafana/grafana.ini
### END INIT INFO

cd || exit 1
. etc/omd/site.conf
if [ "$CONFIG_GRAFANA" != "on" ] ; then
    exit 5
fi
. lib/omd/init_profile
. .profile


# allow the setting of enviroment variable for customization
# e.g. for AWS sigv4 auth see https://docs.aws.amazon.com/prometheus/latest/userguide/AMP-onboard-query-standalone-grafana.html

NAME="grafana"
GRAFANA_HOME=$OMD_ROOT/share/grafana
CONF_DIR=$OMD_ROOT/etc/grafana
WORK_DIR=$GRAFANA_HOME
DATA_DIR=$OMD_ROOT/var/grafana
LOG_DIR=$OMD_ROOT/var/log/grafana
CONF_FILE=$CONF_DIR/grafana.ini
PID_FILE=$OMD_ROOT/tmp/run/grafana.pid
LOG_FILE=$LOG_DIR/grafana.log
DAEMON=$OMD_ROOT/bin/grafana
OPTS="server --homepath=${GRAFANA_HOME} --pidfile=${PID_FILE} --config=${CONF_FILE} cfg:default.paths.data=${DATA_DIR} cfg:default.paths.logs=${LOG_DIR}"
NOHUP=1
KILL_SESSION=1
START_TIMEOUT=60
STOP_CALLBACK="kill_stale_plugins_callback"
# domain gets used in the share dashboard menu
DOMAIN=$(hostname -f)
export GF_SERVER_DOMAIN="$DOMAIN"

set -a
[ -r $CONF_DIR/environment ] && . $CONF_DIR/environment
set +a

mkdir -p "$LOG_DIR" "$DATA_DIR"

# add post hook for first start
if ! test -s $OMD_ROOT/var/grafana/data/grafana.db; then
    START_CALLBACK=grafana_post_start
    START_TIMEOUT=150
fi
grafana_post_start() {
    COMPLETED_PATTERN="migrations completed"
    echo -n "first run, waiting for initial database creation"
    for x in $(seq 600); do
        grep -c "$COMPLETED_PATTERN" $LOG_FILE >/dev/null 2>&1 && break
        [ $((x%10)) -eq 0 ] && echo -n "."
        if [ $x -gt 30 ]; then
            if !__generic_init_pid >/dev/null 2>&1; then
                echo "grafana pid disapeared"
                ps -fu $USER
                break # stop if pid disapears
            fi
        fi
        sleep 0.1
    done
    SUCCESS=$(grep -c "$COMPLETED_PATTERN" $LOG_FILE)
    if [ "$SUCCESS" -eq 0 ]; then
        # try again once, but disable this callback
        tail $LOG_FILE
        echo -n " failed, trying again..."
        START_CALLBACK=
        rm -f $PID_FILE $OMD_ROOT/var/grafana/data/grafana.db*
        __generic_init_wait_start
    fi
    for x in $(seq 600); do
        grep -c "$COMPLETED_PATTERN" $LOG_FILE >/dev/null 2>&1 && break
        [ $((x%10)) -eq 0 ] && echo -n "."
        if [ $x -gt 30 ]; then
            __generic_init_pid >/dev/null 2>&1 || break # stop if pid disapears
        fi
        sleep 0.1
    done
    sleep 1
    SUCCESS=$(grep -c "$COMPLETED_PATTERN" $LOG_FILE)
    if [ "$SUCCESS" -eq 0 ]; then
        echo ""
        echo "startup failed, see the logfile for details: $LOG_FILE"
        exit 1
    fi

    # PID changes during migration, so update pid file
    PID=$(pgrep -u $OMD_SITE -o -f "$PSPATTERN")
    if [ -z $PID ]; then
        ps -fu $USER
        echo ""
        echo "startup failed, grafana not running, see the logfile for details: $LOG_FILE"
        exit 1
    fi
    echo $PID > $PID_FILE
}

# kill stale grafana plugins after shutdown
kill_stale_plugins_callback() {
  local COUNTER=$1
  if [ $COUNTER -ne 50 -a $COUNTER -ne 0 ]; then
    return
  fi

  kill_stale_plugins
}

# kill stale grafana plugins datasource daemons
kill_stale_plugins() {
  pkill -u $OMD_SITE -P 1 -f "/share/grafana/plugins" >/dev/null 2>&1
}

case "$1" in start|restart|reload)
    # remove auto installed previous versions which are shipped with grafana
    # and previously updated automatically
    PLUGINS_REMOVE="
        var/grafana/plugins/grafana-lokiexplore-app
        var/grafana/plugins/grafana-pyroscope-app
    "
    for REM in $PLUGINS_REMOVE; do
        if [ "$REM" -ot "$OMD_ROOT/version" ]; then
            rm -rf "$REM"
        fi
    done
esac

case "$1" in start|restart|reload|stop)
  # kill stale grafana plugins datasource daemons
  kill_stale_plugins
esac

__generic_init "$*"
