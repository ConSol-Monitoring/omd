From 3b889fc82a0fbdabc8839e7a49f8afcac7acb540 Mon Sep 17 00:00:00 2001
From: Sven Nierlein <Sven.Nierlein@consol.de>
Date: Mon, 9 Nov 2026 14:56:46 +0100
Subject: [PATCH 2/2] Start command file worker after reading object data

Start the command file worker only after read_all_object_data() has
finished, so external commands processed during startup cannot race
with the retention data and have their acknowledgements overwritten
(review comment on #553).
---
 src/naemon/naemon.c | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/src/naemon/naemon.c b/src/naemon/naemon.c
index 60f60b9f..a59f9c21 100644
--- a/src/naemon/naemon.c
+++ b/src/naemon/naemon.c
@@ -568,14 +568,7 @@ int main(int argc, char **argv)
 
 		registered_commands_init(200);
 		register_core_commands();
-		/* fire up command file worker */
-		timing_point("Launching command file worker\n");
-		launch_command_file_worker();
-		timing_point("Launched command file worker\n");
 
-		/* read in all object config data after launching the command worker
-		 * to keep the memory footprint of the command worker smaller
-		 */
 		if (result == OK) {
 			nm_log(NSLOG_INFO_MESSAGE, "Reading all config object data\n");
 			timing_point("Reading all object data\n");
@@ -583,6 +576,16 @@ int main(int argc, char **argv)
 			timing_point("Read all object data\n");
 		}
 
+		/* only start processing external commands after the objects have
+		 * been read, so commands arriving during startup cannot be
+		 * overwritten by the retention data
+		 */
+		if (result == OK) {
+			timing_point("Launching command file worker\n");
+			launch_command_file_worker();
+			timing_point("Launched command file worker\n");
+		}
+
 		/* initialize check workers */
 		timing_point("Spawning %u workers\n", wproc_num_workers_spawned);
 		if (init_workers(num_check_workers) < 0) {
