#! /bin/bash

# shared target discovery helper (sits next to this script)
TT_BIN="$(dirname "$(readlink -f "$0")")/trap_targets"

start() {
  logger starting samplicate_watch
  inventory
  while [ 1 ]; do
    sleep 60
    inventory
  done
}

inventory() {
  PORTS=""
  TARGETS_DIR="/var/lib/samplicate_watch"
  TARGETS_FILE="${TARGETS_DIR}/targets.env"
  ACTIVE_PORTS=$(ps -ef | grep /opt/omd/versions/default/bin/samplicate | grep samplicate.pid | sed -e 's/.*-f //g')
  if [ -x /usr/bin/omd ]; then
    # discovery via the shared helper (single source of truth, R7):
    # 127.0.0.1:<port> per line -> the incumbent's "127.0.0.1/<port>"
    # space-separated grammar with a leading space
    TARGETS="$("$TT_BIN" targets 2>/dev/null)"
    if [ -n "$TARGETS" ]; then
      PORTS=" $(echo "$TARGETS" | sed 's/:\([0-9][0-9]*\)$/\/\1/' | paste -sd' ' -)"
    fi
    if [ -z "$PORTS" ];then
      if [ -n "$ACTIVE_PORTS" ]; then
        logger samplicate_watch stops samplicate
        systemctl stop samplicate
        rm -rf $TARGETS_DIR
      fi
    elif [ "$PORTS" != " $ACTIVE_PORTS" ]; then
      logger samplicate_watch changes ports from ${ACTIVE_PORTS:--} to ${PORTS:--} and restarts samplicate
      test -d $TARGETS_DIR || mkdir -p $TARGETS_DIR
      printf "SAMPLICATE_TARGETS=\"%s\"\n" "$PORTS" > $TARGETS_FILE
      systemctl restart samplicate
    else
      :
      #logger samplicate_watch ignores samplicate
    fi
  fi
}

stop() {
  # endless loop. we will never stop
  logger stopping samplicate_watch
  rm -rf $TARGETS_DIR
}


case $1 in
  start|stop|inventory) "$1" ;;
esac

