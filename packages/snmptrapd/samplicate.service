[Unit]
Description=Samplicate snmptrapd forwarder
After=samplicate_watch
Requires=samplicate_watch

[Service]
EnvironmentFile=/var/tmp/samplicate_targets.env
ExecStart=/opt/omd/versions/default/bin/samplicate -m /run/samplicate.pid -S -p 162 -f $SAMPLICATE_TARGETS
Type=forking
PIDFile=/run/samplicate.pid

[Install]
WantedBy=multi-user.target
